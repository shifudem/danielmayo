---
import "../styles/global.css";
import { portfolio, type Lang } from "../data/portfolio-i18n";
import { caseStudies, caseStudyUI } from "../data/case-studies";
import { recruiterConversion } from "../data/recruiter-conversion";
import { githubEvidence, githubEvidenceUI } from "../data/github-evidence";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = portfolio[lang];
const base = import.meta.env.BASE_URL;

const urls = {
  en: "https://shifudem.github.io/danielmayo/",
  es: "https://shifudem.github.io/danielmayo/es/",
  zh: "https://shifudem.github.io/danielmayo/zh/"
};
const hrefs = { en: base, es: `${base}es/`, zh: `${base}zh/` };
const labels = { en: "EN", es: "ES", zh: "中文" };
const canonical = urls[lang];
const studies = caseStudies[lang];
const caseUI = caseStudyUI[lang];
const evidence = githubEvidence[lang];
const evidenceUI = githubEvidenceUI[lang];
const recruiter = recruiterConversion[lang];
const recruiterMailto = `mailto:mayodanielernesto@gmail.com?subject=${encodeURIComponent(recruiter.mailSubject)}&body=${encodeURIComponent(recruiter.mailBody)}`;
---
<!doctype html>
<html lang={c.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={c.meta.description} />
  <meta name="author" content="Daniel Ernesto Mayo" />
  <meta name="theme-color" content="#06101a" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={urls.en} />
  <link rel="alternate" hreflang="es-AR" href={urls.es} />
  <link rel="alternate" hreflang="zh-CN" href={urls.zh} />
  <link rel="alternate" hreflang="x-default" href={urls.en} />
  <meta property="og:title" content={c.meta.title} />
  <meta property="og:description" content={c.meta.description} />
  <meta property="og:type" content="profile" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={c.ogLocale} />
  <meta property="og:image" content="https://shifudem.github.io/danielmayo/images/daniel-mayo-profile.png" />
  <title>{c.meta.title}</title>
</head>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="#top"><span class="brand-mark">DM</span><span>Daniel Mayo</span></a>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="#work">{c.nav.work}</a><a href="#evidence">{evidenceUI.nav}</a><a href="#expertise">{c.nav.expertise}</a><a href="#experience">{c.nav.experience}</a><a href="#education">{c.nav.education}</a><a href="#recruiter">{recruiter.nav}</a><a href="#contact">{c.nav.contact}</a>
    </nav>
    <nav class="language-switcher" aria-label="Language selector">
      {(["en","es","zh"] as Lang[]).map(code => <a href={hrefs[code]} class:list={{ active: code === lang }} aria-current={code === lang ? "page" : undefined}>{labels[code]}</a>)}
    </nav>
  </div>
</header>

<main id="top">
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="status"><span></span>{c.hero.availability}</div>
      <p class="eyebrow">{c.hero.eyebrow}</p>
      <h1>{c.hero.title} <em>{c.hero.accent}</em></h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="actions"><a class="btn primary" href="#work">{c.hero.work}</a><a class="btn recruiter-link" href="#recruiter">{recruiter.heroCta}</a><a class="btn ghost" href="mailto:mayodanielernesto@gmail.com">{c.hero.contact}</a><a class="text-link" href="https://www.linkedin.com/in/jiaodem/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
      <p class="location">{c.hero.location}</p>
    </div>
    <aside class="portrait-panel">
      <div class="portrait-glow"></div>
      <img class="portrait" src={`${base}images/daniel-mayo-profile.png`} alt="Daniel Ernesto Mayo" width="400" height="400" loading="eager" fetchpriority="high" />
      <div class="portrait-caption"><div><strong>Daniel Ernesto Mayo</strong><span>{c.hero.caption}</span></div><b>{c.hero.years}</b></div>
    </aside>
  </div>
  <div class="container metrics">{c.metrics.map(([value,label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div>
</section>

<section class="section intro-section">
  <div class="container split-head"><div><p class="eyebrow">{c.intro.eyebrow}</p><h2>{c.intro.title}</h2></div><p class="section-copy">{c.intro.body}</p></div>
  <div class="container value-grid">{c.values.map(([n,title,body]) => <article><span>{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

<section id="work" class="section work-section">
  <div class="container split-head">
    <div><p class="eyebrow">{c.work.eyebrow}</p><h2>{c.work.title}</h2></div>
    <p class="section-copy">{c.work.body}</p>
  </div>

  <div class="container case-study-grid">
    {studies.map((study,index) => (
      <article class:list={["case-study-card", { featured: study.featured }]}>
        <div class="case-study-topline">
          <div class="case-study-id">
            <span>{String(index+1).padStart(2,"0")}</span>
            <span>{study.kicker}</span>
          </div>
          <span class:list={["case-study-type", { public: Boolean(study.repoUrl) }]}>
            {study.repoUrl ? caseUI.public : caseUI.operational}
          </span>
        </div>

        <h3>{study.title}</h3>
        <p class="case-study-summary">{study.summary}</p>

        <div class="case-flow">
          <div>
            <span class="case-label">{caseUI.problem}</span>
            <p>{study.problem}</p>
          </div>
          <div>
            <span class="case-label">{caseUI.architecture}</span>
            <p>{study.architecture}</p>
          </div>
          <div>
            <span class="case-label">{caseUI.role}</span>
            <p>{study.role}</p>
          </div>
          <div>
            <span class="case-label">{caseUI.result}</span>
            <p>{study.result}</p>
          </div>
        </div>

        <div class="case-study-footer">
          <div class="tags">{study.tags.map(tag => <span>{tag}</span>)}</div>
          {study.repoUrl && (
            <a class="repo-link" href={study.repoUrl} target="_blank" rel="noreferrer">
              {caseUI.viewRepo} ↗
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="container github-note">
    <p>{caseUI.githubNote}</p>
    <a href="https://github.com/shifudem" target="_blank" rel="noreferrer">{caseUI.githubCta} ↗</a>
  </div>
</section>

<section id="evidence" class="section evidence-section">
  <div class="container split-head">
    <div>
      <p class="eyebrow">{evidenceUI.eyebrow}</p>
      <h2>{evidenceUI.title}</h2>
    </div>
    <p class="section-copy">{evidenceUI.body}</p>
  </div>

  <div class="container evidence-grid">
    {evidence.map((item,index) => (
      <article class="evidence-card">
        <div class="evidence-card-header">
          <div>
            <span class="evidence-index">{String(index + 1).padStart(2, "0")}</span>
            <p class="evidence-eyebrow">{item.eyebrow}</p>
          </div>
          <span class="evidence-status">{item.status}</span>
        </div>

        <h3>{item.title}</h3>
        <a class="repo-name" href={item.repoUrl} target="_blank" rel="noreferrer">{item.repo} ↗</a>
        <p class="evidence-description">{item.description}</p>

        <div class="architecture-block">
          <span class="architecture-title">{evidenceUI.architecture}</span>
          <div class="architecture-flow">
            {item.architecture.map((node, nodeIndex) => (
              <>
                <span class="architecture-node">{node}</span>
                {nodeIndex < item.architecture.length - 1 && <span class="architecture-arrow" aria-hidden="true">→</span>}
              </>
            ))}
          </div>
        </div>

        <div class="proof-block">
          <h4>{item.proofTitle}</h4>
          <ul>
            {item.proof.map(point => <li>{point}</li>)}
          </ul>
        </div>

        <div class="evidence-tags">
          {item.tags.map(tag => <span>{tag}</span>)}
        </div>

        <div class="evidence-actions">
          <a class="btn ghost" href={item.repoUrl} target="_blank" rel="noreferrer">{evidenceUI.source} ↗</a>
          {item.liveUrl && <a class="btn ghost" href={item.liveUrl} target="_blank" rel="noreferrer">{evidenceUI.live} ↗</a>}
        </div>

        <div class="source-evidence">
          <span>{evidenceUI.inspect}</span>
          <div>
            {item.links.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="container evidence-note">
    <span>VERIFY</span>
    <p>{evidenceUI.note}</p>
  </div>
</section>

<section id="expertise" class="section">
  <div class="container split-head"><div><p class="eyebrow">{c.expertise.eyebrow}</p><h2>{c.expertise.title}</h2></div><p class="section-copy">{c.expertise.body}</p></div>
  <div class="container expertise-grid">{c.skills.map(([title,body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

<section id="experience" class="section experience-section">
  <div class="container split-head"><div><p class="eyebrow">{c.experience.eyebrow}</p><h2>{c.experience.title}</h2></div><p class="section-copy">{c.experience.body}</p></div>
  <div class="container timeline">{c.roles.map(role => <article class="timeline-item"><div class="timeline-date">{role.years}</div><div><h3>{role.title}</h3><p>{role.body}</p><div class="tags">{role.stack.map(tag => <span>{tag}</span>)}</div></div></article>)}</div>
</section>

<section id="recruiter" class="section recruiter-section">
  <div class="container split-head recruiter-heading">
    <div><p class="eyebrow">{recruiter.eyebrow}</p><h2>{recruiter.title}</h2></div>
    <p class="section-copy">{recruiter.body}</p>
  </div>

  <div class="container hire-grid">
    {recruiter.reasons.map(([n,title,body]) => (
      <article class="hire-reason">
        <span>{n}</span>
        <h3>{title}</h3>
        <p>{body}</p>
      </article>
    ))}
  </div>

  <div class="container profile-heading">
    <p class="eyebrow">{recruiter.profilesEyebrow}</p>
    <h2>{recruiter.profilesTitle}</h2>
    <p>{recruiter.profilesBody}</p>
  </div>

  <div class="container recruiter-profile-grid">
    {recruiter.profiles.map(profile => (
      <article class:list={["recruiter-profile", `profile-${profile.key}`]}>
        <span class="profile-badge">{profile.badge}</span>
        <h3>{profile.title}</h3>
        <p>{profile.body}</p>
        <div class="recruiter-role-list">
          {profile.roles.map(role => <span>{role}</span>)}
        </div>
        <div class="cv-actions">
          <a class="btn primary" href={`${base}${profile.cvEn}`} download>{recruiter.downloadEn}</a>
          <a class="btn ghost" href={`${base}${profile.cvEs}`} download>{recruiter.downloadEs}</a>
        </div>
      </article>
    ))}
  </div>

  <div class="container recruiter-cta">
    <div>
      <p class="eyebrow">{recruiter.ctaEyebrow}</p>
      <h3>{recruiter.ctaTitle}</h3>
      <p>{recruiter.ctaBody}</p>
      <small>{recruiter.response}</small>
    </div>
    <div class="recruiter-cta-actions">
      <a class="btn primary" href={recruiterMailto}>{recruiter.email}</a>
      <a class="btn ghost" href="https://www.linkedin.com/in/jiaodem/" target="_blank" rel="noreferrer">{recruiter.linkedin}</a>
    </div>
  </div>
</section>

<section class="section"><div class="container science-panel"><div class="science-mark">SCIENCE × SYSTEMS</div><div><p class="eyebrow">{c.science.eyebrow}</p><h2>{c.science.title}</h2><p>{c.science.body}</p></div></div></section>

<section id="education" class="section"><div class="container split-head compact"><div><p class="eyebrow">{c.education.eyebrow}</p><h2>{c.education.title}</h2></div></div><div class="container degree-grid">{c.degrees.map(([degree,school]) => <article><h3>{degree}</h3><p>{school}</p></article>)}</div></section>

<section id="contact" class="section contact-section"><div class="container contact-panel"><div><p class="eyebrow">{c.contact.eyebrow}</p><h2>{c.contact.title}</h2><p>{c.contact.body}</p></div><div class="contact-actions"><a class="btn primary" href="mailto:mayodanielernesto@gmail.com">{c.contact.email}</a><a class="btn ghost" href="https://www.linkedin.com/in/jiaodem/" target="_blank" rel="noreferrer">LinkedIn</a><a class="btn ghost" href="https://github.com/shifudem" target="_blank" rel="noreferrer">GitHub</a></div></div></section>
</main>
<footer><div class="container footer"><strong>Daniel Ernesto Mayo</strong><span>{c.footer}</span><span>© 2026</span></div></footer>
</body>
</html>
